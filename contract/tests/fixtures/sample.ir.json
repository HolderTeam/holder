        {
          "name": "card_id",
          "type": {
            "kind": "named",
            "name": "CardId"
          }
        }
      ],
      "returns": {
        "kind": "named",
        "name": "Card"
      },
      "errors": [
        "NotFound"
      ],
      "daemon_only": false
    },
    {
      "name": "list_cards",
      "source": "sample/cards.py",
      "summary": "List a project's cards, one page at a time.",
      "description": null,
      "parameters": [
        {
          "name": "project_id",
          "type": {
            "kind": "string",
            "min_length": 1
          },
          "doc": "The project to list."
        },
        {
          "name": "parent",
          "type": {
            "kind": "nullable",

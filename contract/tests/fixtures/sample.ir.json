            "kind": "nullable",
            "value": {
              "kind": "string"
            }
          },
          "omittable": true
        },
        {
          "name": "meta",
          "doc": "Free-form details; replaces the stored value.",
          "type": {
            "kind": "json"
          },
          "omittable": true
        }
      ]
    },

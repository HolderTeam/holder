              "kind": "union",
              "alternatives": [
                {
                  "kind": "literal",
                  "values": [
                    "roots"
                  ]
                },
                {
                  "kind": "named",
                  "name": "CardId"
                }
              ]
            }
          },
          "default": null
        },
        {
          "name": "limit",
          "type": {
            "kind": "int32",
            "ge": 1,
            "le": 5000
          },
          "default": 200
        },
        {
          "name": "cursor",
          "type": {
            "kind": "nullable",
            "value": {
              "kind": "string"
            }
          },
          "default": null
        }
      ],
      "returns": {
        "kind": "named",
        "name": "Page",
        "arguments": [
          {
            "kind": "named",
            "name": "CardListItem"
          }
        ]
      },
      "errors": [],
      "daemon_only": false
    },
    {
      "name": "update_message",
      "source": "sample/cards.py",
      "summary": "Change an AI message.",
      "description": null,
      "parameters": [
        {
          "name": "message_id",
          "type": {
            "kind": "string"
          }
        },
        {
          "name": "patch",
          "type": {
            "kind": "named",
            "name": "MessagePatch"
          }
        }
      ],
      "returns": {
        "kind": "none"
      },
      "errors": [
        "NotFound",
        "Conflict"
      ],
      "daemon_only": false
    },
    {
      "name": "get_asset_content",
      "source": "sample/cards.py",
      "summary": "Read an asset's bytes.",
      "description": null,
      "parameters": [
        {
          "name": "asset_id",
          "type": {
            "kind": "string"
          }
        }
      ],
      "returns": {
        "kind": "bytes"
      },
      "errors": [
        "NotFound"
      ],
      "daemon_only": false
    },
    {
      "name": "run_ai",
      "source": "sample/cards.py",
      "summary": "Start an AI run and stream its events.",
      "description": null,
      "parameters": [
        {
          "name": "prompt",
          "type": {
            "kind": "string",
            "min_length": 1
          }
        }
      ],
      "returns": {
        "kind": "stream",
        "items": {
          "kind": "named",
          "name": "RunEvent"
        }
      },
      "errors": [],

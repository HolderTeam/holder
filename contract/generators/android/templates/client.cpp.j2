// {{ enum.kotlin_name }}, from its C value, which counts from 1.
jobject to_java_{{ enum.c_type }}(JNIEnv* env, int value) {
  static const jclass type = global_class(env, "{{ class_path }}/{{ enum.kotlin_name }}");
  static const jmethodID values = env->GetStaticMethodID(type, "values", "()[L{{ class_path }}/{{ enum.kotlin_name }};");
  auto entries = static_cast<jobjectArray>(env->CallStaticObjectMethod(type, values));
  if (!entries) return nullptr;
  jobject entry = env->GetObjectArrayElement(entries, value - 1);
  env->DeleteLocalRef(entries);
  return entry;
}

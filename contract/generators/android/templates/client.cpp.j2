jobject to_java_{{ c.c_type }}(JNIEnv* env, const {{ c.c_type }}& value) {
  static const jclass type = global_class(env, "{{ c.java_class }}");
  if (!type) return nullptr;
  static const jmethodID constructor = env->GetMethodID(type, "<init>", "{{ c.constructor }}");
  if (!constructor) return nullptr;
  Locals locals(env);
  jvalue args[{{ [c.fields|length, 1]|max }}] = {};
{% for f in c.fields %}
{% if f.value.is_object %}
  args[{{ loop.index0 }}].l = locals.add({{ to_java(f.value, "value." ~ f.name) }});
  if (env->ExceptionCheck()) return nullptr;
{% else %}
  args[{{ loop.index0 }}].{{ f.value.jvalue }} = {{ to_java(f.value, "value." ~ f.name) }};
{% endif %}
{% endfor %}
  return env->NewObjectA(type, constructor, args);
}

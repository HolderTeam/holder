#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake+ninja --builddirectory=build -- \
		-DHOLDER_USE_SYSTEM_CASTE=ON \
		-DHOLDER_USE_SYSTEM_CORE=ON \
		-DBUILD_TESTING=OFF \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo

override_dh_auto_test:
	# Tests are covered by CI; package builds disable BUILD_TESTING.

# holderd uses core's C++ headers, which have no stable ABI across versions (only the C API
# does), so it needs the libholder0 from the same upstream version it was built against. Any
# Debian revision of that version is accepted, so a packaging-only libholder0 fix still installs.
override_dh_gencontrol:
	dh_gencontrol -- -Vlibholder:Upstream=$$(dpkg-query -W -f='$${source:Upstream-Version}' libholder0)

%:
	dh $@ --buildsystem=cmake+ninja --builddirectory=build

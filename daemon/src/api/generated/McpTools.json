{
  "tools": [
    {
      "name": "get_card",
      "description": "Fetch a card.\n\nA card in the trash or in another project is not found.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "$ref": "#/$defs/ProjectId"
          },
          "card_id": {
            "$ref": "#/$defs/CardId"
          }
        },
        "required": [
          "project_id",
          "card_id"
        ],
        "additionalProperties": false,
        "$defs": {
          "ProjectId": {
            "type": "string",
            "minLength": 1
          },
          "CardId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/$defs/Card"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "$defs": {
          "Card": {
            "properties": {
              "card_id": {
                "$ref": "#/$defs/CardId",
                "description": "The card's ID."
              },
              "project_id": {
                "$ref": "#/$defs/ProjectId",
                "description": "The project the card belongs to."
              },
              "title": {
                "type": "string",
                "title": "Title",
                "description": "The card's title."
              },
              "rel_path": {
                "type": "string",
                "title": "Rel Path",
                "description": "The card's file, relative to the project's root."
              },
              "parent_card_id": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/CardId"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The card's parent; null for a root card."
              },
              "sort_key": {
                "type": "number",
                "format": "double",
                "title": "Sort Key",
                "description": "The card's place among its siblings; lower comes first."
              },
              "created_at": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Created At",
                "description": "When the card was created."
              },
              "updated_at": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Updated At",
                "description": "When the card was last changed."
              },
              "deleted_at": {
                "anyOf": [
                  {
                    "type": "integer",
                    "maximum": 9223372036854775807,
                    "minimum": -9223372036854775808,
                    "format": "int64"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Deleted At",
                "description": "When the card was moved to the trash; null when it is not in the trash."
              },
              "content": {
                "type": "string",
                "title": "Content",
                "description": "The card's body."
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "Tags",
                "description": "The card's normalized tags."
              },
              "tag_occurrences": {
                "items": {
                  "$ref": "#/$defs/TagOccurrence"
                },
                "type": "array",
                "title": "Tag Occurrences",
                "description": "Each tag written in the content, in order."
              },
              "removable_tags": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "Removable Tags",
                "description": "The tags remove_card_tag would take off the card: each is on its trailing tag line and nowhere else in its\ncontent. A tag also written in prose stays until the content is edited."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "card_id",
              "project_id",
              "title",
              "rel_path",
              "parent_card_id",
              "sort_key",
              "created_at",
              "updated_at",
              "deleted_at",
              "content",
              "tags",
              "tag_occurrences",
              "removable_tags"
            ],
            "title": "Card",
            "description": "A card, with its content and tags."
          },
          "CardId": {
            "type": "string",
            "minLength": 1
          },
          "ProjectId": {
            "type": "string",
            "minLength": 1
          },
          "TagOccurrence": {
            "properties": {
              "tag": {
                "type": "string",
                "title": "Tag",
                "description": "The normalized tag."
              },
              "byte_start": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Byte Start",
                "description": "Inclusive byte offset of the leading # in the content."
              },
              "byte_end": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Byte End",
                "description": "Exclusive byte offset after the tag's name."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "tag",
              "byte_start",
              "byte_end"
            ],
            "title": "TagOccurrence",
            "description": "A tag written in a card's content."
          }
        }
      }
    },
    {
      "name": "get_card_breadcrumbs",
      "description": "Read a live card's path from its project root.\n\nThe project comes first, then live ancestor cards and the requested card. A missing or trashed\ncard is not found; a broken or cyclic ancestor chain is invalid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "project_id": {
            "$ref": "#/$defs/ProjectId"
          },
          "card_id": {
            "$ref": "#/$defs/CardId"
          }
        },
        "required": [
          "project_id",
          "card_id"
        ],
        "additionalProperties": false,
        "$defs": {
          "ProjectId": {
            "type": "string",
            "minLength": 1
          },
          "CardId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "items": {
              "$ref": "#/$defs/CardBreadcrumb"
            },
            "type": "array",
            "title": "Data"
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false,
        "$defs": {
          "CardBreadcrumb": {
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "project",
                  "card"
                ],
                "title": "Kind",
                "description": "Whether this step names the project or a card."
              },
              "id": {
                "type": "string",
                "title": "Id",
                "description": "The project or card ID."
              },
              "title": {
                "type": "string",
                "title": "Title",
                "description": "The project or card title."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "id",
              "title"
            ],
            "title": "CardBreadcrumb",
            "description": "One project or live card in a card's path from its project root."
          }
        }
      }
    },
    {
      "name": "get_resource",

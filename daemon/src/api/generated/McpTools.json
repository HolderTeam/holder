          "ProjectId": {
            "type": "string",
            "minLength": 1
          },
          "ResourceType": {
            "type": "string",
            "minLength": 1
          },
          "ResourceMetadata": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "object"
          },
          "ResourceAsset": {
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1,
                "title": "Asset Id",
                "description": "The asset's ID."
              },
              "original_filename": {
                "type": "string",
                "title": "Original Filename",
                "description": "The file's name when it was imported."
              },
              "media_type": {
                "type": "string",
                "title": "Media Type",
                "description": "The file's media type, such as application/pdf."
              },
              "byte_size": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Byte Size",
                "description": "The file's size, in bytes."
              },
              "plaintext_sha256": {
                "type": "string",
                "title": "Plaintext Sha256",
                "description": "The SHA-256 of the file's content, in lower-case hex."
              },
              "placements": {
                "items": {
                  "$ref": "#/$defs/AssetPlacement"
                },
                "type": "array",
                "title": "Placements",
                "description": "The stored copies of the file."
              },
              "created_at": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Created At",
                "description": "When the asset was imported."
              },
              "updated_at": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Updated At",
                "description": "When the asset was last changed."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "asset_id",
              "original_filename",
              "media_type",
              "byte_size",
              "plaintext_sha256",
              "placements",
              "created_at",
              "updated_at"
            ],
            "title": "ResourceAsset",
            "description": "A file that belongs to a resource."
          },
          "AssetPlacement": {
            "properties": {
              "placement_id": {
                "type": "string",
                "minLength": 1,
                "title": "Placement Id",
                "description": "The copy's ID."
              },
              "location_id": {
                "type": "string",
                "minLength": 1,
                "title": "Location Id",
                "description": "The storage location that holds the copy."
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "plain",
                  "holder_asset_v1"
                ],
                "title": "Encoding",
                "description": "How the copy is stored: as the file is, or encrypted for the project."
              },
              "stored_byte_size": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Stored Byte Size",
                "description": "The size of the stored copy, in bytes."
              },
              "created_at": {
                "type": "integer",
                "maximum": 9223372036854775807,
                "minimum": -9223372036854775808,
                "format": "int64",
                "title": "Created At",
                "description": "When the copy was stored."
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "placement_id",
              "location_id",
              "encoding",
              "stored_byte_size",
              "created_at"
            ],
            "title": "AssetPlacement",
            "description": "One stored copy of an asset."
          }
        }
      }

--- a/gtk/a11y/gtkaccesskitcontext.c
+++ b/gtk/a11y/gtkaccesskitcontext.c
@@ -1816,6 +1816,13 @@
       PangoLayout *layout = gtk_label_get_layout (label);
       float x, y;
 
+      /* Presentation labels can still be explicit labelled-by targets,
+       * notably inside GtkModelButton. AccessKit only derives text from
+       * Label roles, so retain their plain text as a direct label. */
+      if (role == ACCESSKIT_ROLE_GENERIC_CONTAINER &&
+          !gtk_at_context_has_accessible_property (ctx, GTK_ACCESSIBLE_PROPERTY_LABEL))
+        accesskit_node_set_label (node, gtk_label_get_text (label));
+
       gtk_label_get_layout_location (label, &x, &y);
       add_single_text_layout (self, update, node, layout, x, y);
     }

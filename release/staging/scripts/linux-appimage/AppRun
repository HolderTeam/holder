#!/usr/bin/env bash
set -euo pipefail

APPDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# holderctl ensure uses this to start the bundled holderd instead of the host's systemd service.
# The AppImage runtime sets it already; running AppRun from an unpacked AppDir does not.
export APPDIR
multiarch="x86_64-linux-gnu"
release_dir="${APPDIR}/usr/share/holder/release"
pixbuf_cache_template="${APPDIR}/usr/lib/${multiarch}/gdk-pixbuf-2.0/2.10.0/loaders.cache.in"
runtime_cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/holder/appimage"

install -d -m 0700 "${runtime_cache_dir}"
escaped_appdir="$(printf '%s' "${APPDIR}" | sed 's/[&|]/\\&/g')"
sed "s|@APPDIR@|${escaped_appdir}|g" \
  "${pixbuf_cache_template}" \
  > "${runtime_cache_dir}/gdk-pixbuf-loaders.cache"

export PATH="${APPDIR}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/${multiarch}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
export XDG_DATA_DIRS="${APPDIR}/usr/share${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}"
export GSETTINGS_SCHEMA_DIR="${APPDIR}/usr/share/glib-2.0/schemas"
export GIO_EXTRA_MODULES="${APPDIR}/usr/lib/${multiarch}/gio/modules"
export GDK_PIXBUF_MODULEDIR="${APPDIR}/usr/lib/${multiarch}/gdk-pixbuf-2.0/2.10.0/loaders"
export GDK_PIXBUF_MODULE_FILE="${runtime_cache_dir}/gdk-pixbuf-loaders.cache"
export GTK_PATH="${APPDIR}/usr/lib/${multiarch}/gtk-4.0"
export ENCHANT_CONFIG_DIR="${APPDIR}/usr/share/enchant-2"
export DICPATH="${APPDIR}/usr/share/hunspell"

# The desktop starts its own backend (holderctl ensure, found beside it in usr/bin): it starts the
# bundled holderd if none is running, refuses one outside the API range it was built for, and the
# daemon stops itself shortly after the window closes. Nothing here owns a daemon any more.
if [ "${HOLDER_APPRUN_SMOKE_TEST:-0}" = "1" ]; then
  # Start the bundled daemon the way the desktop does, check that it is healthy, and stop the
  # one this started, so a smoke test leaves nothing running.
  api_minimum="$(cat "${release_dir}/holder-desktop-daemon-api-minimum.txt")"
  api_maximum_exclusive="$(cat "${release_dir}/holder-desktop-daemon-api-maximum-exclusive.txt")"
  spawned_pid=""
  smoke_cleanup() {
    if [ -n "${spawned_pid}" ] && kill -0 "${spawned_pid}" 2>/dev/null; then
      kill -TERM "${spawned_pid}" 2>/dev/null || true
    fi
  }
  trap smoke_cleanup EXIT
  ensure_status=0
  ensure_result="$(holderctl ensure --json \
    --api-min "${api_minimum}" --api-max-exclusive "${api_maximum_exclusive}" \
    --idle-exit 30 --timeout 60)" || ensure_status=$?
  # ensure reports the daemon it started even when that daemon then failed or was refused, so the
  # cleanup stops it in every case.
  spawned_pid="$(printf '%s\n' "${ensure_result}" \
    | sed -n 's/.*"spawned_pid": *\([0-9][0-9]*\).*/\1/p' | head -n 1)"
  if [ "${ensure_status}" -ne 0 ]; then
    printf '%s\n' "${ensure_result}" >&2
    echo "The bundled Holder daemon could not be started or is outside the supported API range." >&2
    exit 1
  fi
  holderctl health
  exit 0
fi

exec "${APPDIR}/usr/bin/holder-desktop" "$@"

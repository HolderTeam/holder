<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Plain HTTP is allowed to this machine's loopback address and nowhere
     else, so a build made with -Pholder.githubMock can reach the local mock GitHub through
     adb reverse. Every other host keeps the platform default of HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
